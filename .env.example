# Hugging Face Token (Required for gated datasets like bigbio/med_qa and HF Inference API)
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Model Selection (override seeds.yaml)
CAAR_LLM_MODEL=microsoft/Phi-3-mini-4k-instruct
CAAR_EMBEDDING_MODEL=BAAI/bge-m3
CAAR_NLI_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli
CAAR_RAGAS_JUDGE_MODEL=microsoft/Phi-3-mini-4k-instruct

# Knowledge Base & Vector Store
CHROMA_PERSIST_DIR=data/chroma_db

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/caar_cdss

# Kaggle Output Directory
KAGGLE_RESULTS_DIR=/kaggle/working/results

# Logging & Environment
LOG_LEVEL=INFO
ENVIRONMENT=development
